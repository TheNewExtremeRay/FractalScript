// using "//" makes the script ignore anything written there
// set the grid
// sets a 16x16 grid for the screen(not 16x16p just 16x16)
Grid(16, 16).
// "."can be used as an end of line
// start a loop
// writing "loop-[name]" starts a set loop
loop-IfRule
// check for a button keyboard press "F"
if ([keyboard] {press} = f) {
// "(" opens the "if" rules "[]" determines what the first rule is, or it tells the script where to look for a rule, "{}" is optional for setting a second rule, or it can be used for continuing the first location string
// set row 5 column 6 the the color red
// colors are determined with numbers (0-black 1-red 2-orange 3-yellow 4-lime 5-green 6-dark green 7-light blue 8-cyan 9-blue 10-dark blue 11-magenta 12-purple 13-dark pink 14-pink 15-light pink 16-dark gray 15-gray 16-light gray 17-white
set (Grid[r5, c6] {1}).
// set row 6 column 6 to the "images.png" file
// setting a part of the grid to a picture just imports the specified pic into the location specified on the grid
set (Grid[r6, c6] {"(C:)\FractalScript\images.png"}.
// else strings are used for showing something if the if rule isn't used
// set the grid to show all grid locations as green
// if you set 4 locations on a "(Grid)" string it is used as a "from, to"
} else {
set (Grid[r1, c1, r16, c16] {5}).
}
loop-IfRule-end