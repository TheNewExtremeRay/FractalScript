// set the format
Text
// set a loop
loop-ExampleVarAndPress
// add a new variable
set (Var[ZPress] {create}).
// set an "if" rule
// if Z is pressed it adds 1 to the variable
if ([keyboard] {press} = z) {
  set (Var[ZPress] {add(1)}).
// say the current amount of a specific Variable
// doing "||[Var {"Variable Name"}||" just shows the current amount of that exact variable
  say ("current ZPress count: ||[Var] {ZPress}||")
} else {
  set (Var[ZPress] {hold}).
}
loop-ExampleVarAndPress-end